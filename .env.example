# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Chế độ giọng đọc TTS:
# - chipmunk: Tèo Sóc Chuột vui nhộn (Mặc định, Offline, Không vang)
# - diemdam:  Nam Trầm Điềm Đạm (Offline, ấm áp)
# - tramvang: Nam Trầm Vang (Offline, rõ ràng)
# - google:   Google TTS chuẩn ngữ âm (~200ms)
TEO_TTS_MODE=chipmunk

# Thành phố mặc định để tra cứu thời tiết
TEO_DEFAULT_CITY=Ha Noi

# Model Vision (tùy chọn nếu DEEPSEEK_MODEL chưa hỗ trợ ảnh trực tiếp, vd: deepseek-flash)
VISION_MODEL=deepseek-flash

# Khóa bí mật chia sẻ HMAC-SHA256 để xác thực gói lệnh/kết quả qua Wi-Fi giữa Laptop và ESP32-S3
TEO_WIFI_SECRET=change_this_to_a_strong_shared_secret_key
