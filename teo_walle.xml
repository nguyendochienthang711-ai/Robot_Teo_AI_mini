<mujoco model="teo_lekiwi_omni">
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.2 0.3 0.4" rgb2="0.05 0.08 0.12" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.18 0.22 0.28" rgb2="0.25 0.30 0.38" width="512" height="512"/>
    <material name="mat_grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="mat_body" rgba="0.92 0.68 0.15 1"/>      <!-- Màu vàng WALL-E -->
    <material name="mat_base" rgba="0.22 0.24 0.28 1"/>      <!-- Đế tròn 3 bánh Omni LeKiwi -->
    <material name="mat_wheel" rgba="0.12 0.12 0.14 1"/>     <!-- Bánh xe đa hướng Omni -->
    <material name="mat_roller" rgba="0.55 0.58 0.62 1"/>    <!-- Con lăn phụ trên vành bánh Omni -->
    <material name="mat_screen" rgba="0.05 0.08 0.12 1"/>    <!-- Màn hình LCD ST7789 -->
    <material name="mat_eye" rgba="0.0 0.85 1.0 1"/>         <!-- Đôi mắt LED xanh -->
    <material name="mat_arm" rgba="0.75 0.75 0.78 1"/>       <!-- Tay kim loại -->
    <material name="mat_ir" rgba="0.9 0.15 0.15 1"/>         <!-- 3 mắt hồng ngoại IR chống rơi bàn -->
  </asset>

  <worldbody>
    <!-- Mặt bàn làm việc -->
    <geom name="table_floor" type="plane" size="1 1 0.05" material="mat_grid" friction="0.02 0.001 0.0001"/>
    <light pos="0 -0.5 1.2" dir="0 0.5 -1" directional="true"/>

    <!-- Thân chính của Tèo: Thân trên WALL-E + Đế tròn 3 bánh Omni LeKiwi (đường kính 11cm) -->
    <body name="chassis" pos="0 0 0.068">
      <freejoint name="root"/>

      <!-- Tấm đế tròn Kiwi Drive (đường kính 11cm = bán kính 0.055m) -->
      <geom name="omni_base_plate" type="cylinder" pos="0 0 -0.032" size="0.055 0.006" material="mat_base" mass="0.15"/>

      <!-- 3 Cảm biến hồng ngoại IR chống rơi mép bàn (đặt lệch 120 độ quanh mép đế) -->
      <geom name="ir_sensor_1" type="sphere" pos="0.052 0 -0.038" size="0.003" material="mat_ir" mass="0.001"/>
      <geom name="ir_sensor_2" type="sphere" pos="-0.026 0.045 -0.038" size="0.003" material="mat_ir" mass="0.001"/>
      <geom name="ir_sensor_3" type="sphere" pos="-0.026 -0.045 -0.038" size="0.003" material="mat_ir" mass="0.001"/>

      <!-- Đệm trượt đa hướng (Holonomic low-friction contact pads) dưới gầm đế -->
      <geom name="omni_pad_1" type="sphere" pos="0.045 0 -0.058" size="0.01" rgba="0 0 0 0" friction="0.01 0.001 0.0001" mass="0.02"/>
      <geom name="omni_pad_2" type="sphere" pos="-0.0225 0.039 -0.058" size="0.01" rgba="0 0 0 0" friction="0.01 0.001 0.0001" mass="0.02"/>
      <geom name="omni_pad_3" type="sphere" pos="-0.0225 -0.039 -0.058" size="0.01" rgba="0 0 0 0" friction="0.01 0.001 0.0001" mass="0.02"/>

      <!-- Thân hộp WALL-E phía trên -->
      <geom name="torso_box" type="box" pos="0 0 0.01" size="0.038 0.042 0.038" material="mat_body" mass="0.30"/>
      <geom name="chest_panel" type="box" pos="0.039 0 0.015" size="0.002 0.028 0.018" rgba="0.3 0.3 0.32 1" mass="0.01"/>

      <!-- BÁNH OMNI 1: Phía trước (Góc 0 độ - Kênh 3 PCA9685, MG90S 360) -->
      <body name="omni_wheel_1" pos="0.048 0 -0.044" euler="0 0 0">
        <joint name="wheel_1_joint" type="hinge" axis="1 0 0" damping="0.02"/>
        <geom name="w1_disc" type="cylinder" size="0.024 0.006" euler="0 90 0" material="mat_wheel" contype="0" conaffinity="0" mass="0.03"/>
        <geom name="w1_hub" type="cylinder" size="0.010 0.008" euler="0 90 0" material="mat_roller" contype="0" conaffinity="0" mass="0.005"/>
      </body>

      <!-- BÁNH OMNI 2: Sau Trái (Góc 120 độ - Kênh 4 PCA9685, MG90S 360) -->
      <body name="omni_wheel_2" pos="-0.024 0.0416 -0.044" euler="0 0 120">
        <joint name="wheel_2_joint" type="hinge" axis="1 0 0" damping="0.02"/>
        <geom name="w2_disc" type="cylinder" size="0.024 0.006" euler="0 90 0" material="mat_wheel" contype="0" conaffinity="0" mass="0.03"/>
        <geom name="w2_hub" type="cylinder" size="0.010 0.008" euler="0 90 0" material="mat_roller" contype="0" conaffinity="0" mass="0.005"/>
      </body>

      <!-- BÁNH OMNI 3: Sau Phải (Góc 240 độ - Kênh 5 PCA9685, MG90S 360) -->
      <body name="omni_wheel_3" pos="-0.024 -0.0416 -0.044" euler="0 0 240">
        <joint name="wheel_3_joint" type="hinge" axis="1 0 0" damping="0.02"/>
        <geom name="w3_disc" type="cylinder" size="0.024 0.006" euler="0 90 0" material="mat_wheel" contype="0" conaffinity="0" mass="0.03"/>
        <geom name="w3_hub" type="cylinder" size="0.010 0.008" euler="0 90 0" material="mat_roller" contype="0" conaffinity="0" mass="0.005"/>
      </body>

      <!-- Servo 0 (Kênh 0 PCA9685): Cổ và Đầu gắn màn hình LCD hai mắt -->
      <body name="head_neck" pos="0 0 0.055">
        <joint name="neck_yaw" type="hinge" axis="0 0 1" range="-70 70" damping="0.1"/>
        <geom name="neck_post" type="cylinder" size="0.01 0.015" rgba="0.5 0.5 0.5 1" mass="0.02"/>
        <geom name="head_box" type="box" pos="0.005 0 0.025" size="0.022 0.036 0.02" material="mat_body" mass="0.05"/>
        <geom name="lcd_screen" type="box" pos="0.028 0 0.025" size="0.002 0.03 0.015" material="mat_screen" mass="0.005"/>
        <geom name="eye_left" type="cylinder" pos="0.031 0.014 0.025" size="0.008 0.001" euler="0 90 0" material="mat_eye" mass="0.001"/>
        <geom name="eye_right" type="cylinder" pos="0.031 -0.014 0.025" size="0.008 0.001" euler="0 90 0" material="mat_eye" mass="0.001"/>
      </body>

      <!-- Servo 1 (Kênh 1 PCA9685): Cánh tay Trái -->
      <body name="left_arm" pos="0.01 0.050 0.018">
        <joint name="left_arm_pitch" type="hinge" axis="0 1 0" range="-90 90" damping="0.08"/>
        <geom name="l_arm_geom" type="box" pos="0.025 0 0" size="0.028 0.006 0.008" material="mat_arm" mass="0.02"/>
      </body>

      <!-- Servo 2 (Kênh 2 PCA9685): Cánh tay Phải -->
      <body name="right_arm" pos="0.01 -0.050 0.018">
        <joint name="right_arm_pitch" type="hinge" axis="0 1 0" range="-90 90" damping="0.08"/>
        <geom name="r_arm_geom" type="box" pos="0.025 0 0" size="0.028 0.006 0.008" material="mat_arm" mass="0.02"/>
      </body>
    </body>
  </worldbody>

  <!-- Bộ truyền động: 6 Kênh PWM trên module I2C PCA9685 (3 Servo MG90S 180° + 3 Servo MG90S 360° Omni) -->
  <actuator>
    <position name="servo_neck" joint="neck_yaw" kp="2.5" ctrlrange="-1.2 1.2"/>
    <position name="servo_left_arm" joint="left_arm_pitch" kp="2.0" ctrlrange="-1.5 1.5"/>
    <position name="servo_right_arm" joint="right_arm_pitch" kp="2.0" ctrlrange="-1.5 1.5"/>
    <velocity name="servo_omni_w1" joint="wheel_1_joint" kv="0.5" ctrlrange="-15 15"/>
    <velocity name="servo_omni_w2" joint="wheel_2_joint" kv="0.5" ctrlrange="-15 15"/>
    <velocity name="servo_omni_w3" joint="wheel_3_joint" kv="0.5" ctrlrange="-15 15"/>
  </actuator>
</mujoco>
